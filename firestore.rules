rules_version = '2';

// V6 Firestore Security Rules (CF-7).
//
// Principle: deny by default. Allow only authenticated users to access their own
// documents. The server uses Firebase Admin SDK which bypasses these rules
// entirely, so client-side reads/writes must be strictly user-scoped.
//
// Note: This file is the SOURCE-OF-TRUTH for rules in the repository. To
// deploy run: firebase deploy --only firestore:rules
// (or via gcloud firestore security-rules update if not using Firebase CLI).
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: authenticated user.
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: requesting user matches the document's owner.
    // Used for top-level collections where userId is a field on the document.
    function ownsDoc(resource) {
      return isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Helper: requesting user matches the {userId} path segment
    // (used for users/{uid}/... subcollections).
    function ownsUserPath(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---------- Top-level user-owned collections ----------

    // Transactions: every doc carries userId.
    match /transactions/{txId} {
      allow read: if ownsDoc(resource);
      // On create, the client must set userId to their own UID.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Updates only allowed if the doc is already owned by this user, AND
      // the update does NOT change userId to a different owner.
      allow update: if ownsDoc(resource)
                    && (request.resource.data.userId == null || request.resource.data.userId == resource.data.userId);
      allow delete: if ownsDoc(resource);
    }

    // Commitments.
    match /commitments/{cId} {
      allow read: if ownsDoc(resource);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if ownsDoc(resource)
                    && (request.resource.data.userId == null || request.resource.data.userId == resource.data.userId);
      allow delete: if ownsDoc(resource);
    }

    // Reports.
    match /reports/{rId} {
      allow read: if ownsDoc(resource);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if ownsDoc(resource)
                    && (request.resource.data.userId == null || request.resource.data.userId == resource.data.userId);
      allow delete: if ownsDoc(resource);
    }

    // Idempotency keys (V6, CF-6): each entry is owned by one user.
    match /idempotency_keys/{keyId} {
      allow read: if ownsDoc(resource);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if ownsDoc(resource);
      allow delete: if false; // server-managed only
    }

    // ---------- User-scoped subcollections ----------

    // users/{uid} document itself (profile / settings).
    match /users/{userId} {
      allow read: if ownsUserPath(userId);
      allow create: if ownsUserPath(userId);
      allow update: if ownsUserPath(userId);
      allow delete: if ownsUserPath(userId);

      // Memory subcollection.
      match /memory/{memoryId} {
        allow read: if ownsUserPath(userId);
        allow write: if ownsUserPath(userId);
      }

      // Budgets subcollection.
      match /budgets/{budgetId} {
        allow read: if ownsUserPath(userId);
        allow write: if ownsUserPath(userId);
      }

      // Notifications subcollection.
      match /notifications/{notifId} {
        allow read: if ownsUserPath(userId);
        allow write: if ownsUserPath(userId);
      }

      // Treasurer profile subcollection.
      match /treasurer/{docId} {
        allow read: if ownsUserPath(userId);
        allow write: if ownsUserPath(userId);
      }

      // Savings goals subcollection.
      match /savingsGoals/{goalId} {
        allow read: if ownsUserPath(userId);
        allow write: if ownsUserPath(userId);
      }

      // Gaza/Palestine market directory subcollection.
      match /marketDirectory/{offerId} {
        allow read: if ownsUserPath(userId);
        allow write: if ownsUserPath(userId);
      }
    }

    // debts collection (legacy recurring items path — kept for backward compatibility,
    // but only the owning user can read their own subscription entries).
    match /debts/{debtId} {
      allow read: if ownsDoc(resource);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if ownsDoc(resource);
      allow delete: if ownsDoc(resource);
    }

    // Default deny — any path not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
