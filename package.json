{
  "name": "masrofi-ai",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/auth.test.ts tests/financial.test.ts tests/durability.test.ts tests/authorization.test.ts tests/concurrency.test.ts tests/offline.test.ts tests/market.test.ts tests/e2e.test.ts tests/v6_2_adversarial.test.ts tests/financial_pipeline.test.ts",
    "test:v6": "node --import tsx --test tests/auth.test.ts tests/financial.test.ts tests/durability.test.ts tests/authorization.test.ts",
    "test:v6_1": "node --import tsx --test tests/concurrency.test.ts tests/offline.test.ts tests/market.test.ts tests/e2e.test.ts",
    "test:v6_2": "node --import tsx --test tests/v6_2_adversarial.test.ts",
    "test:auth": "node --import tsx --test tests/auth.test.ts",
    "ci:trigger": "node -e \"console.log('CI verification trigger: render auto-deploy check')\"",
    "test:financial": "node --import tsx --test tests/financial.test.ts",
    "test:durability": "node --import tsx --test tests/durability.test.ts",
    "test:authz": "node --import tsx --test tests/authorization.test.ts",
    "test:conc": "node --import tsx --test tests/concurrency.test.ts",
    "test:off": "node --import tsx --test tests/offline.test.ts",
    "test:market": "node --import tsx --test tests/market.test.ts",
    "test:e2e": "node --import tsx --test tests/e2e.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  },
  "description": "Masrofi AI personal finance assistant",
  "engines": {
    "node": ">=20.0.0"
  }
}
