# Server
NODE_ENV=production
PORT=3000

# Required for chat, receipt scan, market search, and live voice
GEMINI_API_KEY=your_gemini_api_key_here

# Required on Render for Firebase Admin SDK.
# Paste the complete Firebase service-account JSON as one line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@....iam.gserviceaccount.com"}

# Optional aliases supported by src/server/firebaseAdmin.ts
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_FILE=
# GOOGLE_APPLICATION_CREDENTIALS=

# Optional Supabase integration
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
